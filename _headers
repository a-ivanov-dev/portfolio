# Security headers for every page. Cloudflare Pages reads this file automatically.
# The two sha256 values allow the two inline <script> blocks in index.html.
# If you ever change the code INSIDE a <script> block, its hash changes and the
# browser will block it: recompute the hash and update it here.
# Changing text, links or CSS does NOT require touching this file.
# HSTS is set in the Cloudflare dashboard after go-live, not here.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-w0cCR4x7TXeRlrWO2NZveeHW5ts9J+kQLseS1di/A2I=' 'sha256-vwxRkulnp57Mb+sjBqNbGdz5BaaH97muMf/XA8G2HF8='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
