---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import DocPage from '../../components/DocPage.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TopicLinks from '../../components/TopicLinks.astro';
import PrevNext from '../../components/PrevNext.astro';
import { STATUS } from '../../config';
import { getWork, hasWriteup, ym } from '../../lib/content';

export async function getStaticPaths() {
  const work = (await getWork()).filter(hasWriteup);   // newest first, only items with a page
  const link = (e?: (typeof work)[number]) => (e ? { href: `/work/${e.id}/`, title: e.data.title } : undefined);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: link(work[i - 1]), older: link(work[i + 1]) },
  }));
}

const { entry, newer, older } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const f = d.findings;
const sev = f ? ([['c', 'Crit', f.crit], ['h', 'High', f.high], ['m', 'Med', f.med], ['l', 'Low', f.low]] as const).filter((s) => s[2] !== undefined) : [];
---
<Base title={d.title} description={d.summary} image={d.cover}>
  <DocPage back={{ href: '/work/', label: 'All work' }}>
    <Breadcrumbs items={[{ label: 'Work', href: '/work/' }, { label: d.code.replace('-', '–') }]} />
    <h1 class="doc__title">{d.title}</h1>
    <div class="doc__meta">
      <span>Date <b>{ym(d.date, '–')}</b></span>
      {d.type && <span>Type <b>{d.type}</b></span>}
      {d.scope && <span>Scope <b>{d.scope}</b></span>}
      <span>Status <b>{STATUS[d.status as keyof typeof STATUS].label}</b></span>
    </div>
    <TopicLinks topics={d.topics} />
    {d.tags.length > 0 && <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>}
    {sev.length > 0 && (
      <div class="doc__sev" aria-label="Findings by severity">
        {sev.map(([k, label, n]) => <span class={`sev__i sev__i--${k}`}><span class="sev__d"></span>{label} <span class="sev__n">{n}</span></span>)}
      </div>
    )}

    {d.cover && <Image src={d.cover} alt={d.coverAlt ?? ''} class="doc__cover" />}

    <Content />

    <PrevNext newer={newer} older={older} />

    <div class="docfoot">
      {d.links.map((l) => <a class="act" href={l.href}>{l.label} &rarr;</a>)}
      <span class="sp"></span>
      <a class="back" href="/work/">All work &rarr;</a>
    </div>
  </DocPage>
</Base>
