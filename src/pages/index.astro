---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import WorkCard from '../components/WorkCard.astro';
import PostItem from '../components/PostItem.astro';
import { render } from 'astro:content';
import { STATUS } from '../config';
import { getSite, getCredentials, getWork, getPosts, getUsedTopics, getMenuPages, forHome } from '../lib/content';

const site = await getSite();
const SITE = site.data;
const { Content: Summary } = await render(site);   // the text of site/home.md
const credentials = await getCredentials();
const menu = await getMenuPages();
const allWork = await getWork();
const allPosts = await getPosts();
const work = forHome(allWork, SITE.homeWork);
const posts = forHome(allPosts, SITE.homeBlog);
const topics = (await getUsedTopics()).slice(0, SITE.skyTopics);

// Structured data so search engines connect the site to you as a person.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: Astro.site?.toString(),
  sameAs: [SITE.github, SITE.linkedin],
};
---
<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person).replace(/</g, '\\u003c')}></script>

  <Hero topics={topics} />

  <div class="shell">
    <aside class="rail">
      <div>
        <h1 class="rail__name">{SITE.name}</h1>
        <p class={SITE.rolesStacked ? 'rail__role rail__role--stack' : 'rail__role'}>
          {SITE.roles.map((r, i) => <>{!SITE.rolesStacked && i > 0 && ' · '}<span>{r}</span></>)}
        </p>
      </div>
      <p class="rail__blurb">{SITE.blurb}</p>
      <nav class="rail__nav">
        <a class="rail__link" href="#summary">Summary</a>
        <a class="rail__link" href="#work">Work</a>
        <a class="rail__link" href="#blog">Blog</a>
        <a class="rail__link" href="#creds">Credentials</a>
        <a class="rail__link" href="#contact">Contact</a>
        {menu.map((p) => <a class="rail__link" href={`/${p.id}/`}>{p.data.title}</a>)}
      </nav>
      <div class="rail__soc">
        <a class="mono" href={SITE.github}>GitHub</a>
        <a class="mono" href={SITE.linkedin}>LinkedIn</a>
        <a class="mono" href={`mailto:${SITE.email}`}>Email</a>
      </div>
    </aside>

    <main class="content">
      <section class="sec" id="summary">
        <h2 class="sec__label"><span class="mono">01 &mdash; Summary</span></h2>
        <div class="prose"><Summary /></div>
      </section>

      <section class="sec" id="work">
        <h2 class="sec__label"><a class="mono sec__link" href="/work/" aria-label="All work">02 &mdash; Work &rarr;</a></h2>
        {work.map((entry) => <WorkCard entry={entry} />)}
        {allWork.length > 0 && <p class="more"><a class="act" href="/work/" aria-label="All work">All work ({allWork.length}) &rarr;</a></p>}
      </section>

      <section class="sec" id="blog">
        <h2 class="sec__label"><a class="mono sec__link" href="/blog/" aria-label="All posts">03 &mdash; Blog &rarr;</a></h2>
        {posts.length === 0
          ? <p class="post__s">First post coming soon.</p>
          : posts.map((entry) => <PostItem entry={entry} />)}
        {allPosts.length > 0 && <p class="more"><a class="act" href="/blog/" aria-label="All posts">All posts ({allPosts.length}) &rarr;</a></p>}
      </section>

      <section class="sec" id="creds">
        <h2 class="sec__label"><span class="mono">04 &mdash; Credentials</span></h2>
        <div class="tw">
          <table class="trk">
            <thead>
              <tr><th scope="col">Credential</th><th scope="col">Area</th><th scope="col">When</th><th scope="col">Status</th></tr>
            </thead>
            <tbody>
              {credentials.map(({ data: c }) => (
                <tr>
                  <td>{c.name}</td><td>{c.domain}</td><td>{c.target}</td>
                  <td><span class={`chip chip--${STATUS[c.status as keyof typeof STATUS].chip}`}>{STATUS[c.status as keyof typeof STATUS].label}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="sec" id="contact">
        <h2 class="sec__label"><span class="mono">05 &mdash; Contact</span></h2>
        <h3 class="sec__h">Get in touch</h3>
        <div class="prose">
          <p>{SITE.contact}</p>
          <ul class="contact">
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><a href={SITE.github}>GitHub</a></li>
            <li><a href={SITE.linkedin}>LinkedIn</a></li>
          </ul>
        </div>
      </section>
    </main>
  </div>

  <script is:inline src="/scripts/sky.js" defer slot="scripts"></script>
</Base>
