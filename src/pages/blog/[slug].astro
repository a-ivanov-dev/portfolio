---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DocPage from '../../components/DocPage.astro';
import { getPosts, ym } from '../../lib/content';

export async function getStaticPaths() {
  return (await getPosts()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.title} description={d.summary}>
  <DocPage>
    <p class="doc__eyebrow">Blog</p>
    <h1 class="doc__title">{d.title}</h1>
    <div class="doc__meta"><span>Date <b>{ym(d.date, '–')}</b></span></div>
    {d.tags.length > 0 && <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>}

    <Content />

    <div class="docfoot">
      <span class="sp"></span>
      <a class="back" href="/#blog">All posts &rarr;</a>
    </div>
  </DocPage>
</Base>
