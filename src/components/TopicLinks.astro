---
// "Topics: Detection · SIEM" — each topic links to its topic page.
import { slugify } from '../lib/content';
interface Props { topics: string[]; }
const { topics } = Astro.props;
---
{topics.length > 0 && (
  <p class="topics">
    <span class="topics__l">Topics:</span>
    {topics.map((t, i) => <>{i > 0 && <span class="topics__sep"> &middot; </span>}<a href={`/topics/${slugify(t)}/`}>{t}</a></>)}
  </p>
)}
