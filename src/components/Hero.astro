---
import { getSite, getMenuPages, type TopicInfo } from '../lib/content';

interface Props { topics: TopicInfo[]; }
const { topics } = Astro.props;
const s = (await getSite()).data;
const menu = await getMenuPages();
---
<header class="hero">
  <canvas id="sky" aria-hidden="true"></canvas>

  <div class="chrome">
    <span class="chrome__name">{s.name}</span>
    <nav class="chrome__mid" aria-label="Primary">
      <a href="#summary">Summary</a>
      <a href="#work">Work</a>
      <a href="#blog">Blog</a>
      <a href="#contact">Contact</a>
      {menu.map((p) => <a href={`/${p.id}/`}>{p.data.title}</a>)}
    </nav>
    <button class="tog" type="button" aria-label="Switch colour theme">Theme &mdash; Auto</button>
  </div>

  <!-- Big labels = sections. Small labels = topics, generated from content. -->
  <div class="sky" id="labels">
    <a class="lab lab--xl" href="#work">Work</a>
    <a class="lab lab--l" href="#blog">Blog</a>
    <a class="lab lab--m" href="#summary">Summary</a>
    <a class="lab lab--m" href="#creds">Credentials</a>
    <a class="lab lab--m" href="#contact">Contact</a>
    {menu.map((p) => <a class="lab lab--m" href={`/${p.id}/`}>{p.data.title}</a>)}
    {topics.map((t) => <a class="lab lab--s" href={`/topics/${t.slug}/`}>{t.name}</a>)}
  </div>

  <div class="hero__foot">
    <span class="mono">{s.heroLine} &mdash; {s.location}</span>
    <span class="sp"></span>
    <a class="mono cue" href="#summary">Scroll to summary &darr;</a>
  </div>
</header>
